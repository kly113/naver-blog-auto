# Configuration names only. Store actual secrets securely; never commit them.
DATA_DIR=./data
# Required for local dev:all: choose a separate site password (12+ characters).
APP_OWNER_PASSWORD=
# Optional; enables real paid AI calls when the owner starts a job.
BLOG_AI_API_KEY=
# Optional system tools. The cloud runtime already has these paths.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
PYTHON_EXECUTABLE=./.venv/bin/python
# Production values are injected by the hosting provider.
# WORKER_URL=
# WORKER_AUTH_TOKEN=
# SESSION_ENCRYPTION_KEY=
# APP_PUBLIC_URL=
NAVER_AUTOPUBLISH_VERIFIED=false
